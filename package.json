{
  "name": "obsidian-selective-publisher",
  "version": "1.2.0",
  "description": "An Obsidian plugin that selectively publishes notes to a public repository",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "publishing",
    "git",
    "github-pages"
  ],
  "author": "Ivan Grubišić",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/picomatch": "^4.0.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.0.0",
    "obsidian": "^1.14.4",
    "picomatch": "^4.0.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  }
}
